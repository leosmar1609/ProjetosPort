JWT_SECRET=troque-isso-por-um-segredo-longo-e-aleatorio

# Conexão com o MySQL local (o mesmo servidor que aparece no seu MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fisio_agendamento

# Conta que o "npm run seed" cria pra fisio logar
FISIO_NOME=Nome da Fisioterapeuta
FISIO_EMAIL=fisio@exemplo.com
FISIO_SENHA=troque-esta-senha

# Endereço público do site (usado nos links dos e-mails de lembrete)
SITE_URL=http://localhost:3000

# E-mail de lembrete (24h e 1h antes da sessão)
# EMAIL_PROVIDER=console -> não envia de verdade, só mostra no terminal (bom pra testar)
# EMAIL_PROVIDER=resend  -> envia de verdade pela API da Resend (precisa da RESEND_API_KEY)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_REMETENTE=Anna Barbosa Fisioterapia <onboarding@resend.dev>

# Chave que protege a rota POST /api/lembretes/verificar (chamada por um agendador externo
# em produção). Gere um texto aleatório qualquer.
LEMBRETES_SECRET=troque-por-outro-segredo-aleatorio

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>br.com.lojaodamari</groupId>
    <artifactId>lojaodamari</artifactId>
    <version>1.0.0</version>
  </parent>

  <!-- app desktop (JavaFX) do caixa e da retaguarda. conversa com o servidor pela API -->
  <artifactId>desktop</artifactId>

  <dependencies>
    <dependency>
      <groupId>br.com.lojaodamari</groupId>
      <artifactId>comum</artifactId>
    </dependency>
    <!-- o servidor inteiro vai junto: o app liga ele por dentro, assim o usuário abre um programa só -->
    <dependency>
      <groupId>br.com.lojaodamari</groupId>
      <artifactId>servidor</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- no package, junta todas as bibliotecas do app em target/pacote. o jpackage usa essa pasta pra montar o .exe -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>bibliotecas-do-executavel</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/pacote</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>br.com.lojaodamari.desktop.Iniciar</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
